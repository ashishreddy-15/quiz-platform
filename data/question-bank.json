    {
      "id": "phys-6",
      "subject": "physics",
      "type": "mcq",
      "difficulty": 3,
      "stem": "The Earth pulls down on a book with a 20 N force. What force does the book exert on the Earth?",
      "concepts": [
        "phys.force.newton3"
      ],
      "options": [
        {
          "id": "a",
          "text": "Zero, since the book is so small",
          "misconception": "thinks_only_the_larger_object_exerts_force"
        },
        {
          "id": "b",
          "text": "Much less than 20 N",
          "misconception": "thinks_bigger_object_exerts_bigger_force"
        },
        {
          "id": "c",
          "text": "20 N, directed upward",
          "misconception": null
        },
        {
          "id": "d",
          "text": "20 N, which cancels the pull so the book stays still",
