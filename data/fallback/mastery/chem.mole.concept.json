{
  "items": [
    {
      "kind": "recall",
      "stem": "How many individual particles are there in exactly one mole?",
      "options": [
        {
          "id": "a",
          "text": "$6.02 \\times 10^{23}$ particles",
          "misconception": null
        },
        {
          "id": "b",
          "text": "$6.02 \\times 10^{20}$ particles",
          "misconception": "mole_is_too_small"
        },
        {
          "id": "c",
          "text": "$6.02 \\times 10^{24}$ particles",
          "misconception": "mole_is_too_large"
        },
        {
          "id": "d",
          "text": "1 gram of a substance",
          "misconception": "mole_is_grams"
        }
      ],
      "answer": "a",
      "explanation": "One mole is defined as $6.02 \\times 10^{23}$ particles; the other choices misstate the magnitude or confuse moles with mass."
    },
    {
      "kind": "application",
      "stem": "A sample contains $2.5 \\times 10^{24}$ atoms. How many moles of atoms are present?",
